<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark platform theme so system bars use light icons on the dark
         app background, and the window background matches the app's dark
         gray to avoid a white flash on cold start. -->
    <style name="Theme.WiZcut" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
    </style>
</resources>
