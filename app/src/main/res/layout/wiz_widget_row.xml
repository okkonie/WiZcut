<?xml version="1.0" encoding="utf-8"?>
<!-- Wide widget (3+ cells wide): power, brightness down, brightness up -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btnPower"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_button_circle">

            <ImageView
                android:id="@+id/btnPowerIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_power_toggle"
                android:src="@drawable/lightbulb_24" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnBrightnessDown"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_button_circle">

            <ImageView
                android:id="@+id/btnBrightnessDownIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_brightness_down"
                android:src="@drawable/arrow_down_24" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnBrightnessUp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_button_circle">

            <ImageView
                android:id="@+id/btnBrightnessUpIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_brightness_up"
                android:src="@drawable/arrow_up_24" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
